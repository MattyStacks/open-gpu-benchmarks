---
// One post, guide, or review. Adds the affiliate disclosure, the review
// summary, and the authorship / AI-editing note from frontmatter.
import { Image, getImage } from "astro:assets";
import DisclosureBanner from "../components/DisclosureBanner.astro";
import ReviewSummary from "../components/ReviewSummary.astro";
import { DEFAULT_AUTHOR, POST_TYPES, SITE_URL } from "../config";
import { catalogGpu } from "../lib/api";
import { formatDate, isoDate, type Post } from "../lib/posts";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated, type, tags, gpu_ids, hero, hero_alt, affiliate, ai_generated, ai_assistance, verdict, pros, cons } =
  post.data;
const credit = ai_generated
  ? `Generated with AI and reviewed by ${post.data.author ?? DEFAULT_AUTHOR}.`
  : `Written by ${post.data.author ?? DEFAULT_AUTHOR}.${ai_assistance ? ` AI assistance: ${ai_assistance.replace(/\.$/, "")}.` : ""}`;
const author = post.data.author ?? DEFAULT_AUTHOR;
const base = import.meta.env.BASE_URL;
const canonical = `${SITE_URL}blog/${post.id}/`;

// og:image must be absolute on the canonical origin, whatever BLOG_BASE is.
let ogImage: string | undefined;
if (hero) {
  const social = await getImage({ src: hero, width: 1200, format: "jpeg" });
  ogImage = `${SITE_URL}blog/${social.src.slice(base.length).replace(/^\//, "")}`;
}

const posting = {
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: isoDate(date),
  dateModified: isoDate(updated ?? date),
  author: { "@type": "Person", name: author },
  url: canonical,
  mainEntityOfPage: canonical,
  keywords: tags.join(", "),
  ...(ogImage ? { image: ogImage } : {}),
  isPartOf: { "@id": `${SITE_URL}#website` },
};
const jsonLd =
  type === "review" && verdict
    ? {
        "@context": "https://schema.org",
        ...posting,
        "@type": "Review",
        itemReviewed: { "@type": "Product", name: catalogGpu(gpu_ids[0]).identity.name },
        reviewBody: verdict,
      }
    : { "@context": "https://schema.org", ...posting };
---

<BaseLayout title={title} description={description} path={`${post.id}/`} ogType="article" ogImage={ogImage} jsonLd={jsonLd}>
  <article class="article">
    <header class="article-head">
      <div class="post-meta">
        <a class={`pill pill-${type}`} href={`${base}${POST_TYPES[type].path}/`}>{POST_TYPES[type].label}</a>
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {updated && <span>Updated <time datetime={isoDate(updated)}>{formatDate(updated)}</time></span>}
        <span>By {author}</span>
        {ai_generated && <span class="pill">AI-generated</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {post.data.draft && <aside class="callout callout-warning" role="note"><span class="callout-title">Draft</span>Only the dev server shows this. Set <code>draft: false</code> to publish.</aside>}
      {affiliate && <DisclosureBanner />}
      {hero && <Image class="hero" src={hero} alt={hero_alt ?? ""} widths={[640, 960, 1440]} sizes="(max-width: 800px) 100vw, 760px" loading="eager" />}
    </header>
    {type === "review" && <ReviewSummary gpuIds={gpu_ids} verdict={verdict} pros={pros} cons={cons} />}
    <div class="prose">
      <slot />
    </div>
    <footer class="article-foot">
      <p>
        {credit}
        {affiliate && " Affiliate links are marked and disclosed at the top."}
      </p>
      {
        tags.length > 0 && (
          <p>
            {tags.map((tag) => (
              <a class="tag" href={`${base}tags/${tag}/`}>#{tag} </a>
            ))}
          </p>
        )
      }
      <p><a class="tag" href={base}>← All posts</a></p>
    </footer>
  </article>
</BaseLayout>
