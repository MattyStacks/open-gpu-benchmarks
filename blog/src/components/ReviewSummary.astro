---
// Review header blocks: a spec card per reviewed GPU (from the published
// catalog), then the verdict and pros/cons from frontmatter.
import { catalogGpu } from "../lib/api";

interface Props {
  gpuIds: string[];
  verdict?: string;
  pros: string[];
  cons: string[];
}

const { gpuIds, verdict, pros, cons } = Astro.props;
const fmt = (value: unknown, unit = "") => (value == null || value === "" ? null : `${value}${unit}`);
const cards = gpuIds.map((id) => {
  const gpu = catalogGpu(id);
  const stats = [
    ["Architecture", fmt(gpu.classification.architecture)],
    ["Memory", fmt(`${gpu.memory.capacity_gb} GB ${gpu.memory.type ?? ""}`.trim())],
    ["Bus", fmt(gpu.memory.bus_width_bits, "-bit")],
    ["Bandwidth", fmt(gpu.memory.bandwidth_gbs, " GB/s")],
    ["Shaders", fmt(gpu.silicon?.shader_cores?.toLocaleString("en-US"))],
    ["Boost", fmt(gpu.clocks?.boost_mhz, " MHz")],
    ["Power", fmt(gpu.power?.tdp_w, " W")],
    ["Launch MSRP", gpu.release?.msrp_usd ? `$${gpu.release.msrp_usd}` : null],
  ].filter(([, value]) => value) as [string, string][];
  return { name: gpu.identity.name, stats };
});
---

<section class="review-box" aria-label="Review summary">
  {
    cards.map((card) => (
      <div class="spec-card">
        <h3>{card.name}</h3>
        <div class="mini-grid">
          {card.stats.map(([label, value]) => (
            <div class="mini-stat">
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </div>
    ))
  }
  {
    verdict && (
      <div class="verdict">
        <span class="callout-title">Verdict</span>
        <p>{verdict}</p>
      </div>
    )
  }
  {
    (pros.length > 0 || cons.length > 0) && (
      <div class="pros-cons">
        <div class="spec-card pros">
          <h3>Pros</h3>
          <ul>{pros.map((item) => <li>{item}</li>)}</ul>
        </div>
        <div class="spec-card cons">
          <h3>Cons</h3>
          <ul>{cons.map((item) => <li>{item}</li>)}</ul>
        </div>
      </div>
    )
  }
</section>
